            <description><![CDATA[
                <h2>New Features</h2>
                <ul>
                    <li>Todo Capsule Card: quick note-taking in workspace panel</li>
                    <li>Worktree creation defaults to .claude/worktrees/</li>
                    <li>Worktree sidebar uses italic font for distinction</li>
                </ul>
                <h2>Fixes</h2>
                <ul>
                    <li>Agent status badge: fix stale working status</li>
                    <li>Agent status badge: fix worktree status detection</li>
                    <li>Agent status badge: fix dreaming false positives</li>
                </ul>
            ]]></description>
